---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated } = post.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(`/og/blog/${post.id}.png`, Astro.site).href,
  author: { '@id': `${site.url}/#person`, name: site.name, url: site.url },
};
---

<Base title={title} description={description} og={`blog/${post.id}`} type="article" publishedTime={date} modifiedTime={updated} jsonLd={jsonLd}>
  <article class="page enter">
    <a href="/blog" class="back">← Writing</a>
    <h1>{title}</h1>
    <p class="meta"><time datetime={date.toISOString()}>{fmt(date)}</time></p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
    transition: color 200ms;
  }
  .back:hover {
    color: var(--ink);
  }
  .meta {
    color: var(--ink-3);
  }
  .prose {
    margin-top: 2.5rem;
  }
</style>
