---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Writing" description="Notes by Deepanshu Yadav on building software and hardware." og="blog">
  <div class="page enter">
    <h1>Writing</h1>
    {
      posts.length > 0 ? (
        <ul class="rows list">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}`} class="row">
                <span class="row-title">{p.data.title}</span>
                <span class="row-line" />
                <time class="row-meta" datetime={p.data.date.toISOString()}>
                  {p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
                </time>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="intro">
          Nothing here yet. I’ll write about things I build and what I get wrong along the way.
        </p>
      )
    }
  </div>
</Base>

<style>
  .intro {
    margin-top: 0.5rem;
  }
  .list {
    margin-top: 2rem;
  }
</style>
