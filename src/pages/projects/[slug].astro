---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { diagrams } from '../../data/diagrams';
import Diagram from '../../components/Diagram.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, line, year, kind, stack, links } = project.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const diagram = diagrams[project.id];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description: line,
    url,
    dateCreated: year,
    creator: { '@id': `${site.url}/#person` },
    keywords: stack.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/projects` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={title} description={`${line}. ${kind}, ${year}.`} og={`projects/${project.id}`} type="article" jsonLd={jsonLd}>
  <article class="page enter">
    <a href="/projects" class="back">← Work</a>
    <h1>{title}</h1>
    <p class="meta">{kind} · {year} · {stack.join(', ')}</p>
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a href={l.href} class="u" target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
    {diagram && <Diagram diagram={diagram} id={`d-${project.id}`} />}
    <div class="prose">
      <Content />
    </div>
    <p class="next">
      <span class="muted">Next</span>
      <a href={`/projects/${next.id}`} class="u">{next.data.title}</a>
    </p>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
    transition: color 200ms, transform 300ms var(--ease);
  }

  .back:hover {
    color: var(--ink);
    transform: translateX(-2px);
  }

  .meta {
    color: var(--ink-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.25rem;
  }

  .prose {
    margin-top: 2.5rem;
  }

  :global(.diagram) + .prose {
    margin-top: 0;
  }

  .next {
    display: flex;
    gap: 0.75rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
