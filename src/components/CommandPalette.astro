---
import { getCollection } from 'astro:content';
import { nav, site } from '../data/site';

type Item = { id: string; group: string; label: string; hint?: string; href?: string; action?: string; keywords?: string };

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);

const items: Item[] = [
  { id: 'home', group: 'Pages', label: 'Home', href: '/' },
  ...nav.map((n) => ({ id: n.href, group: 'Pages', label: n.label, href: n.href })),
  { id: 'resume', group: 'Pages', label: 'Résumé', href: '/resume', keywords: 'cv resume' },
  ...projects.map((p) => ({ id: `p-${p.id}`, group: 'Work', label: p.data.title, hint: p.data.kind, href: `/projects/${p.id}`, keywords: `${p.data.line} ${p.data.stack.join(' ')}` })),
  ...posts.map((p) => ({ id: `b-${p.id}`, group: 'Writing', label: p.data.title, href: `/blog/${p.id}` })),
  { id: 'copy', group: 'Actions', label: 'Copy email address', hint: site.email, action: 'copy', keywords: 'contact hire mail' },
  { id: 'theme', group: 'Actions', label: 'Switch light / dark', action: 'theme', keywords: 'dark light mode' },
  { id: 'gh', group: 'Links', label: 'GitHub', hint: 'github.com/dydipanshu', href: site.socials.github },
  { id: 'li', group: 'Links', label: 'LinkedIn', hint: 'in/dydipanshu', href: site.socials.linkedin },
  { id: 'gs', group: 'Links', label: 'Google Scholar', href: site.socials.scholar, keywords: 'paper research ieee' },
];
---

<dialog class="palette no-print" data-palette aria-label="Command menu">
  <div class="panel">
    <div class="field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
        ><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2" stroke-linecap="round"></path></svg
      >
      <input
        type="text"
        placeholder="Where to?"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <kbd>esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" aria-label="Results" data-palette-list>
      {
        items.map((item) => (
          <li
            id={`cmd-${item.id.replace(/[^a-z0-9-]/gi, '')}`}
            role="option"
            aria-selected="false"
            data-group={item.group}
            data-href={item.href}
            data-action={item.action}
            data-search={`${item.label} ${item.hint ?? ''} ${item.keywords ?? ''} ${item.group}`.toLowerCase()}
          >
            <span class="group mono">{item.group}</span>
            <span class="label">{item.label}</span>
            {item.hint && <span class="hint">{item.hint}</span>}
            <span class="enter" aria-hidden="true">↵</span>
          </li>
        ))
      }
    </ul>
    <p class="empty" data-palette-empty hidden>Nothing found.</p>
    <div class="foot mono" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
    </div>
  </div>
</dialog>

<style>
  .palette {
    padding: 0;
    border: 0;
    background: transparent;
    width: min(38rem, calc(100vw - 2rem));
    max-height: none;
    margin: 12vh auto auto;
    overflow: visible;
    color: var(--ink);
  }

  .palette::backdrop {
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .panel {
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.3);
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] .panel {
      animation: pop 300ms var(--ease);
    }
    .palette[open]::backdrop {
      animation: fade 300ms var(--ease);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--line);
  }

  .field svg {
    width: 1.1rem;
    color: var(--ink-3);
    flex: none;
  }

  input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    background: transparent;
    font-size: 1rem;
    outline: none;
  }

  input::placeholder {
    color: var(--ink-3);
  }

  ul {
    list-style: none;
    padding: 0.4rem;
    max-height: min(22rem, 55vh);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    color: var(--ink-2);
    scroll-margin: 0.4rem;
  }

  li[hidden] {
    display: none;
  }

  li[aria-selected='true'] {
    background: var(--bg-2);
    color: var(--ink);
  }

  .group {
    color: var(--ink-3);
    font-size: 0.7rem;
  }

  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hint {
    font-size: 0.8rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .enter {
    color: var(--ink-3);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 150ms,
      transform 150ms;
  }

  li[aria-selected='true'] .enter {
    opacity: 1;
    transform: none;
  }

  .empty {
    padding: 1.5rem 1rem 2rem;
    text-align: center;
    color: var(--ink-3);
  }

  .foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .foot kbd {
    margin-right: 0.2rem;
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr auto;
    }
    .group,
    .hint {
      display: none;
    }
    .foot {
      display: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  let visible = options;
  let active = 0;
  let opener: HTMLElement | null = null;

  const setActive = (i: number) => {
    if (!visible.length) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (i + visible.length) % visible.length;
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    const el = visible[active];
    el.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', el.id);
    el.scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    visible = options.filter((o) => {
      const hit = terms.every((t) => o.dataset.search!.includes(t));
      o.hidden = !hit;
      return hit;
    });
    empty.hidden = visible.length > 0;
    setActive(0);
  };

  const open = () => {
    if (dialog.open) return;
    opener = document.activeElement as HTMLElement;
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  };

  const close = () => {
    dialog.close();
  };

  dialog.addEventListener('close', () => opener?.focus?.());

  const run = (el: HTMLLIElement | undefined) => {
    if (!el) return;
    const { href, action } = el.dataset;
    close();
    if (action === 'copy') {
      const email = el.querySelector('.hint')?.textContent ?? '';
      navigator.clipboard?.writeText(email).catch(() => (location.href = `mailto:${email}`));
    } else if (action === 'theme') {
      (document.querySelector('[data-theme-toggle]') as HTMLButtonElement | null)?.click();
    } else if (href) {
      if (/^https?:/.test(href)) window.open(href, '_blank', 'noopener');
      else location.href = href;
    }
  };

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      run(visible[active]);
    }
  });

  options.forEach((o) => {
    o.addEventListener('pointermove', () => {
      const i = visible.indexOf(o);
      if (i !== active) setActive(i);
    });
    o.addEventListener('click', () => run(o));
  });

  // Click on the backdrop closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !dialog.open && !(e.target as HTMLElement).closest('input, textarea, [contenteditable]')) {
      e.preventDefault();
      open();
    }
  });

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
</script>
