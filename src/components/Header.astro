---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Contact from './Contact.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="page header no-print">
  <div class="me">
    <a href="/" class="name" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
    <Contact />
    <a href={site.resumePdf} class="resume" download data-goatcounter-click="resume-download" data-goatcounter-title="Header">
      Résumé <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </div>
  <nav aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: clamp(1.5rem, 5vw, 3rem);
    padding-bottom: clamp(3rem, 9vw, 5.5rem);
  }

  .me {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
  }

  .resume {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.92em;
    line-height: 1.5;
    transition: opacity 200ms;
  }

  .resume:hover {
    opacity: 0.85;
  }

  .name {
    color: var(--ink);
    font-weight: 500;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--ink-3);
    transition: color 200ms;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .header {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    nav {
      order: 3;
      flex: 1;
    }
    .header :global(.toggle) {
      order: 4;
    }
  }

  @media (max-width: 380px) {
    .me {
      gap: 0.5rem;
    }
    .arrow {
      display: none;
    }
  }
</style>
