---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Contact from './Contact.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="page header no-print">
  <div class="me">
    <a href="/" class="name" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
    <Contact />
  </div>
  <nav aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: clamp(1.5rem, 5vw, 3rem);
    padding-bottom: clamp(3rem, 9vw, 5.5rem);
  }

  .me {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
  }

  .name {
    color: var(--ink);
    font-weight: 500;
  }

  ul {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--ink-3);
    transition: color 200ms;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 440px) {
    .header {
      flex-wrap: wrap;
      row-gap: 0.5rem;
    }
    nav {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
